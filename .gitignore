# pi local state (track project extensions under .pi/extensions/)
.pi/
.pi/*
!.pi/extensions/
!.pi/extensions/**
.spine/runtime/
.spine/batch-state.json
.spine/batch-history.json
.spine/run-metrics.jsonl
.worktrees/

# Router runtime state (SQLite + ONNX model cache + install-local dataset pepper)
.pi-smart-router/
.pi-smart-router/.dataset-key

# Operator-local live campaign prompts (may contain session-derived text)
data/calibration/tasks/

# Panel adjudication sidecars (regenerated prompt/response text)
data/calibration/adjudication/

#SpecKit
.specify/

# Build output (generated by npm run build)
dist/

# Compiled artifacts must not be tracked under scripts/ (SP-265, #150)
# scripts/ runs TypeScript sources directly via tsx; tracked .js/.d.ts/.map
# duplicates drift silently from src/. Enforced by scripts/assert-no-script-artifacts.sh
scripts/src/
scripts/**/*.js
scripts/**/*.js.map
scripts/**/*.d.ts
scripts/**/*.d.ts.map

# Dependencies
node_modules/

# Test artifacts
coverage/

# Cusor 
.cursor/
